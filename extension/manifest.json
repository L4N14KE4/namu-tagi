{
  "manifest_version": 3,
  "name": "나무타기 (나무위키용 비공식 위키게임, 프로토타입)",
  "version": "0.33.9",
  "description": "나무위키에서 시작 문서부터 목표 문서까지 본문 링크만 눌러 도달하는 게임. 비공식 프로토타입.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "devtools_page": "devtools.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://namu.wiki/*"
      ],
      "js": [
        "words.js",
        "hubs.js",
        "vendor/confetti.min.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ]
}
