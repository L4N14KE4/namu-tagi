{
  "manifest_version": 3,
  "name": "나무타기: 나무위키 파도타기 게임",
  "version": "0.1.0",
  "description": "시작 문서에서 목표 문서까지 본문 링크만 눌러 가는 나무위키 게임입니다. 오늘의 문제, 무작위 문제, 친구와의 대결을 즐겨 보세요. 나무위키와 관계없는 비공식 확장입니다.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "devtools_page": "devtools.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://namu.wiki/*"
      ],
      "js": [
        "words.js",
        "hubs.js",
        "vendor/confetti.min.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ]
}
